# =============================================================================
# Art Portfolio — environment variables
# Copy to .env.local for development. Never commit real values.
# All of these are read on the SERVER only; none are exposed to the browser.
# =============================================================================

# --- Nezden database (required) ----------------------------------------------
# Same connection string Nezden uses, PLUS the read-only option so every
# transaction is read-only at the server (accidental writes fail).
# If the URL already has parameters (e.g. ?sslmode=require) join with "&":
#   ...?sslmode=require&options=-c%20default_transaction_read_only%3Don
#
# Local dev with the fixture in docker-compose.dev.yml:
NEZDEN_DATABASE_URL=postgres://nezden:nezden@localhost:5433/nezden?options=-c%20default_transaction_read_only%3Don
# Production on the same Coolify server as Nezden (internal container hostname):
# NEZDEN_DATABASE_URL=postgres://USER:PASSWORD@<postgres-container-name>:5432/nezden?options=-c%20default_transaction_read_only%3Don

# Max connections this app opens to Nezden's database (optional, default 5).
# NEZDEN_DB_POOL_MAX=5

# --- Nezden media (required) -------------------------------------------------
# Public base URL for uploaded images. Needed at BUILD time too (it configures
# next/image's allowed host), so in Coolify mark it as a Build Variable.
# Local dev with docker-compose.dev.yml's media server:
NEZDEN_MEDIA_BASE=http://localhost:8090/media
# Production:
# NEZDEN_MEDIA_BASE=https://nezden.com/media

# --- Application -------------------------------------------------------------
# Public origin of this site; used for canonical URLs, Open Graph, sitemap.
# Falls back to art_site_url from Nezden's profile, then http://localhost:3000.
SITE_URL=http://localhost:3000

# How long (seconds) Nezden data is cached before it is re-read. Default 60.
NEZDEN_REVALIDATE_SECONDS=60

# Optional: lets Nezden (or you) refresh content instantly with
#   curl -X POST https://art.nezden.com/api/revalidate -H "x-revalidate-secret: <secret>"
# Leave empty to disable the endpoint (it then returns 404).
REVALIDATE_SECRET=

# Optional: set to 1 to serve Nezden's images as-is instead of through
# Next.js image optimisation (saves CPU on small servers).
# NEXT_IMAGE_UNOPTIMIZED=1
